<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="8dp"
    tools:context=".SelectVoucherActivity">

    <ImageView
        android:id="@+id/voucherImage"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:contentDescription="Coupon Image"
        android:src="@drawable/coupon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- RecyclerView to show the vouchers -->
    <TextView
        android:id="@+id/selectedVoucherTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/blue"
        android:text="Pick Voucher"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="46sp"
        app:layout_constraintTop_toBottomOf="@id/voucherImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/voucherRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/rounded_container"
        app:layout_constraintTop_toBottomOf="@id/selectedVoucherTextView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
