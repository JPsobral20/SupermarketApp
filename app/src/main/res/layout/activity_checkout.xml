<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".CheckoutActivity"
    android:background="@drawable/background_blue">

    <TextView
        android:id="@+id/checkoutTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/blue"
        android:text="Checkout"
        android:textSize="46sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/cartSummaryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_container"
        android:layout_marginBottom="12dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/checkoutTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/cartSummaryTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Cart Summary"
            android:textColor="@color/white"
            android:textSize="32sp"/>

        <TextView
            android:id="@+id/totalPriceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Total: $0.00"
            android:textColor="@color/orange"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/discountContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_container"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/cartSummaryContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/accumulatedDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Accumulated Discount: "
            android:textSize="24sp"
            android:layout_marginTop="16dp"
            android:textColor="@color/white"/>

        <CheckBox
            android:id="@+id/applyDiscountCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Accumulated Discount"
            android:textSize="16dp"
            android:textColor="@color/white"/>
    </LinearLayout>

    <TextView
        android:id="@+id/selectedVoucherTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No voucher selected"
        android:fontFamily="@font/montserrat_bold"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:textColor="@color/dark_orange"
        app:layout_constraintTop_toBottomOf="@id/discountContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/selectVoucherButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="Select Voucher"
        android:textSize="26sp"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/blue"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/selectedVoucherTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/voucherAccumulationInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/selectVoucherButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/payLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="Pay"
        android:textSize="36sp"
        android:textColor="@color/blue"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/voucherAccumulationInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- QR Code and NFC buttons -->
    <LinearLayout
        android:id="@+id/paymentOptionsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/payLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qrCodeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="QR Code"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="24sp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/dark_orange"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nfcButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NFC"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="24sp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/dark_orange"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
