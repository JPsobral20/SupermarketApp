<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_orange"
    android:padding="16dp"
    tools:context=".LoginActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generate Voucher"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:textSize="52sp"
        android:textStyle="bold"
        android:textColor="@color/dark_orange"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <EditText
        android:id="@+id/receiverUsernameInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Username of receiver"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:minHeight="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Voucher Name Input -->
    <EditText
        android:id="@+id/voucherNameInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Voucher Name"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:minHeight="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/receiverUsernameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Voucher Name Input -->
    <EditText
        android:id="@+id/voucherDiscountPercentageInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Discount Percentage"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:minHeight="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/voucherNameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>


    <!-- Generate Voucher Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/generateVoucherButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Generate"
        android:textSize="26sp"
        android:textColor="@color/white"
        android:fontFamily="@font/montserrat_bold"
        android:backgroundTint="@color/dark_orange"
        app:cornerRadius="12dp"
        android:minHeight="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/voucherDiscountPercentageInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- Menu Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/menuButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="Go Back to Menu"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:minHeight="50dp"
        android:padding="6dp"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/generateVoucherButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
