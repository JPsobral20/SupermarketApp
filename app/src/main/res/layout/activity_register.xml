<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".RegisterActivity"
    android:background="@drawable/background_blue">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.15" />

    <ImageView
        android:id="@+id/supermarketImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/register_picture"
        android:contentDescription="Supermarket Image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline50"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="Welcome"
        android:textSize="46sp"
        android:textStyle="bold"
        android:textColor="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/guideline50"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_light"
        android:text="Register your account to start purchasing!"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Name Input -->
    <EditText
        android:id="@+id/nameInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/full_name_register"
        android:textColorHint="@color/blue"
        android:textColor="@color/blue"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:minHeight="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Username Input -->
    <EditText
        android:id="@+id/usernameInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/username_register"
        android:textColorHint="@color/blue"
        android:textColor="@color/blue"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:minHeight="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/nameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Password Input -->
    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/password_register"
        android:textColorHint="@color/blue"
        android:textColor="@color/blue"
        android:inputType="textPassword"
        android:background="@android:drawable/editbox_background"
        android:minHeight="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/usernameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Repeat Password Input -->
    <EditText
        android:id="@+id/repeatPasswordInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/repeat_password"
        android:textColorHint="@color/blue"
        android:textColor="@color/blue"
        android:inputType="textPassword"
        android:background="@android:drawable/editbox_background"
        android:minHeight="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/passwordInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/CardInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="Card Info"
        android:textColor="@color/blue"
        android:textSize="24sp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:layout_gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/repeatPasswordInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <LinearLayout
        android:id="@+id/cardInfoSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/CardInfo">

        <!-- Card Type Input -->
        <Spinner
            android:id="@+id/cardTypeSpinner"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:background="@android:drawable/editbox_background"
            android:textColor="@color/blue"
            android:textSize="16sp"
            android:padding="8dp"
            android:layout_gravity="center"
            android:spinnerMode="dropdown"/>

        <!-- Card Expiration Date Month Input -->
        <EditText
            android:id="@+id/cardExpirationMonthInput"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:hint="@string/card_month"
            android:textColorHint="@color/blue"
            android:background="@android:drawable/editbox_background"
            android:textColor="@color/blue"
            android:textSize="16sp"
            android:inputType="date"
            android:padding="8dp"
            android:maxLength="2"
            android:layout_gravity="center" />

        <!-- Card Expiration Date Year Input -->
        <EditText
            android:id="@+id/cardExpirationYearInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/card_year"
            android:textColorHint="@color/blue"
            android:background="@android:drawable/editbox_background"
            android:textColor="@color/blue"
            android:textSize="16sp"
            android:inputType="date"
            android:padding="8dp"
            android:maxLength="2"
            android:layout_gravity="center" />
    </LinearLayout>

    <!-- Card Number Input -->
    <EditText
        android:id="@+id/cardNumberInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/card_number"
        android:textColorHint="@color/blue"
        android:textColor="@color/blue"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:minHeight="50dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/cardInfoSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/loginLink"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="Already have an account? Login here"
        android:textColor="@color/blue"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:layout_gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cardNumberInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <!-- Register Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/registerSubmitButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="@string/register"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:minHeight="50dp"
        android:padding="12dp"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/loginLink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
