<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/background_blue">

    <ImageView
        android:id="@+id/voucherImage"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:src="@drawable/coupon"
        android:contentDescription="Voucher Image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title of the Voucher page -->
    <TextView
        android:id="@+id/voucherTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="Your Vouchers"
        android:textSize="42sp"
        android:textColor="@color/blue"
        android:layout_gravity="center"
        app:layout_constraintBottom_toTopOf="@id/voucherImage"
        android:layout_marginBottom="10dp"/>

    <!-- RecyclerView for Available Vouchers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_container"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:text="Available Vouchers"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:paddingVertical="8dp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/availableVouchersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_container"
        android:layout_marginBottom="12dp">
        <!-- RecyclerView for Used Vouchers -->
        <TextView
            android:text="Used Vouchers"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:paddingVertical="8dp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/usedVouchersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- Button to go back to HomePage -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="Go Back"
        android:backgroundTint="@color/blue"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        android:textSize="24sp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp" />
</LinearLayout>
